<resources>
    <style name="TrafficWidgetLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/traffic_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TrafficWidgetRate">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">24sp</item>
        <item name="android:autoSizeMaxTextSize">28sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:text">—</item>
        <item name="android:textDirection">ltr</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:gravity">start</item>
        <item name="android:textColor">@color/traffic_secondary</item>
        <item name="android:textSize">28sp</item>
    </style>
    <style name="TrafficWidgetSession">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/traffic_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
